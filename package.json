    "dprint": "^0.56.0",
    "eslint": "~10.8.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "postcss": "^8.5.26",
