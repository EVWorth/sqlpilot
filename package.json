    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.0",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "~4.12.3",
    "sql-formatter": "^15.8.2",
