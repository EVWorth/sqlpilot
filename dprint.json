{
  "indentWidth": 2,
  "lineWidth": 120,
  "includes": [
    "**/*.{ts,tsx,js,jsx,json,yml,yaml,md,toml}"
  ],
  "excludes": [
    "**/node_modules",
    "**/target",
    "**/dist",
    "**/coverage",
    "**/*.lock",
    "**/*.lockb",
    "src/lib/bindings.ts"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.3",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/toml@0.8.0"
  ]
}
